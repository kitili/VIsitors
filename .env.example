# Local dev uses SQLite automatically at data/visits.db — no env vars needed.

# Vercel production (free Turso SQLite — https://turso.tech)
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Public URL for QR codes (your Vercel domain)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
